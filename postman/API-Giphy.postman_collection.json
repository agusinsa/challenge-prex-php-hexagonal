{
  "info": {
    "name": "API Giphy",
    "description": "Login, búsqueda de GIFs, GIF por id y favorito. El login guarda el token en el environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code !== 200) {",
              "    return;",
              "}",
              "",
              "const body = pm.response.json();",
              "pm.environment.set('token', body.token);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/login"
      },
      "response": [
        {
          "name": "ok",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{base_url}}/login"
          },
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"token\": \"token-plano\",\n  \"expires_in\": 1800\n}"
        }
      ]
    },
    {
      "name": "buscar gifs",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code !== 200) {",
              "    return;",
              "}",
              "",
              "const body = pm.response.json();",
              "const gif = body.data && body.data[0];",
              "",
              "if (gif && gif.id) {",
              "    pm.environment.set('gif_id', gif.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/gifs?query=gato&limit=1&offset=0",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "gifs"
          ],
          "query": [
            {
              "key": "query",
              "value": "gato"
            },
            {
              "key": "limit",
              "value": "1"
            },
            {
              "key": "offset",
              "value": "0"
            }
          ]
        }
      },
      "response": [
        {
          "name": "ok",
          "originalRequest": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/gifs?query=gato&limit=1&offset=0"
          },
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"data\": [\n    {\n      \"id\": \"VkpfO6W4D7yB7vSjXy\",\n      \"title\": \"Cat No GIF\",\n      \"url\": \"https://giphy.com/gifs/no-wtf-black-VkpfO6W4D7yB7vSjXy\"\n    }\n  ]\n}"
        }
      ]
    },
    {
      "name": "gif por id",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/gifs/{{gif_id}}"
      },
      "response": [
        {
          "name": "ok",
          "originalRequest": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/gifs/{{gif_id}}"
          },
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"data\": {\n    \"id\": \"VkpfO6W4D7yB7vSjXy\",\n    \"title\": \"Cat No GIF\",\n    \"url\": \"https://giphy.com/gifs/no-wtf-black-VkpfO6W4D7yB7vSjXy\"\n  }\n}"
        }
      ]
    },
    {
      "name": "guardar favorito",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"gif_id\": \"{{gif_id}}\",\n  \"alias\": \"mi gato\",\n  \"user_id\": {{user_id}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/favorites"
      },
      "response": [
        {
          "name": "creado",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gif_id\": \"{{gif_id}}\",\n  \"alias\": \"mi gato\",\n  \"user_id\": {{user_id}}\n}"
            },
            "url": "{{base_url}}/favorites"
          },
          "status": "Created",
          "code": 201,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"data\": {\n    \"gif_id\": \"VkpfO6W4D7yB7vSjXy\",\n    \"alias\": \"mi gato\",\n    \"user_id\": 1\n  }\n}"
        }
      ]
    }
  ]
}
